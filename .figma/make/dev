#!/usr/bin/env bash
# Starts the Next.js dev server. Runs for the whole session; killed on close.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Load PORT (and FIGMA_MAKE_URL) from the shared env file.
set -a
# shellcheck disable=SC1091
. "$SCRIPT_DIR/env"
set +a

# Move to the repo root (two levels up from .figma/make).
cd "$SCRIPT_DIR/../.."

echo "==> Starting dev server on port ${PORT}"
# Bind 0.0.0.0 so LAN devices (and the preview proxy) can reach it.
exec npm run dev -- --port "${PORT}" --hostname 0.0.0.0
