#!/usr/bin/env bash
# Installs project dependencies. Runs on every project open.
set -euo pipefail

# Move to the repo root (two levels up from .figma/make).
cd "$(dirname "$0")/../.."

echo "==> Installing dependencies with npm"
# npm install is idempotent: fast when the tree is already up to date, and it
# runs the project's postinstall (copies the MapLibre worker into public/).
npm install --no-audit --no-fund

echo "==> Dependencies ready"
