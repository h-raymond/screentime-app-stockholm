#!/usr/bin/env bash
# Verifies the dev server is up and answering on PORT.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Load PORT (and FIGMA_MAKE_URL) from the shared env file.
set -a
# shellcheck disable=SC1091
. "$SCRIPT_DIR/env"
set +a

URL="http://localhost:${PORT}"
echo "==> Verifying dev server at ${URL}"

# Poll for up to ~60s; the first dev compile can take a moment.
for i in $(seq 1 60); do
  if curl -fsS -o /dev/null "${URL}"; then
    echo "==> Dev server is reachable"
    exit 0
  fi
  sleep 1
done

echo "ERROR: Dev server did not respond at ${URL} within 60s." >&2
exit 1
